{
  "name": "@lapismd/ai-controller",
  "version": "0.1.0",
  "description": "Durable provider-neutral AI orchestration and shared client",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./memory/lapis": {
      "types": "./dist/memory/lapis/index.d.ts",
      "import": "./dist/memory/lapis/index.js"
    },
    "./memory/group": {
      "types": "./dist/memory/group/index.d.ts",
      "import": "./dist/memory/group/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./managed": {
      "types": "./dist/managed.d.ts",
      "import": "./dist/managed.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit && pnpm check:architecture && node scripts/check-boundaries.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run",
    "build": "tsc && node scripts/bundle.mjs",
    "build:cli": "deno task build",
    "local:controller": "node scripts/local-controller.mjs",
    "local:agent": "node scripts/local-controller.mjs",
    "spec:check": "spec-validator check",
    "spec:validate": "spec-validator validate",
    "spec:first": "spec-validator first",
    "publint": "publint",
    "docs:write": "tsc && node scripts/docs-cli.mjs",
    "docs:check": "tsc && node scripts/docs-cli.mjs --check"
  },
  "dependencies": {
    "@lapismd/ai-host": "^0.1.0",
    "ajv": "^8.20.0",
    "ws": "^8.18.3",
    "yaml": "^2.9.0",
    "@lapismd/agent-redaction": "^0.1.0"
  },
  "devDependencies": {
    "@lapismd/spec-validator": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "publint": "^0.3.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0"
  }
}
